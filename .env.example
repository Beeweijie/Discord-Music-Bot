DISCORD_TOKEN=your_token_here
# Optional text group chat. Both chat and memory remain disabled until configured per server.
# Enable Message Content Intent in the Discord developer portal as well.
MESSAGE_CONTENT_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Shared daily monetary budget for this bot, including every AI feature.
# Conservative official peak prices, with reported cache discounts. Local-midnight reset.
DEEPSEEK_DAILY_BUDGET_CNY=1
DEEPSEEK_BUDGET_TIMEZONE=Australia/Sydney
# Optional additional UTC-day count ceilings; 0 disables them.
DEEPSEEK_DAILY_REQUEST_LIMIT=0
DEEPSEEK_DAILY_TOKEN_LIMIT=0
# Optional independent embedding provider; base URL must include /v1 if its API requires it.
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=your_embedding_model
# EMBEDDING_API_KEY=
EMBEDDING_DAILY_REQUEST_LIMIT=300
# Required if enabling an external embedding service: conservative CNY/request ceiling.
# Use 0 only for a free local provider.
# EMBEDDING_MAX_REQUEST_CNY=0
# Existing local dashboard; AI pages are available here when the bot is running.
MANAGEMENT_API_ENABLED=true
MANAGEMENT_API_HOST=127.0.0.1
MANAGEMENT_API_PORT=8766
# Optional local voice commands: run python scripts/install_voice.py and install the model first.
VOICE_COMMANDS_ENABLED=false
# VOICE_MODEL_PATH=/absolute/path/to/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17
VOICE_ASR_LANGUAGE=zh
# VOICE_WAKE_MODEL_PATH=/absolute/path/to/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20
# Trusted public GitHub repository used by the owner-only !update command.
UPDATE_GITHUB_URL=https://github.com/Beeweijie/Discord-Music-Bot
